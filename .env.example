PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/lb_institute
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://127.0.0.1:5000

# First administrator is created automatically on first startup if no admin exists.
ADMIN_INITIAL_USERNAME=your-admin-username
ADMIN_INITIAL_PASSWORD=your-admin-password
ADMIN_INITIAL_NAME=Administrator
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_MOBILE=
